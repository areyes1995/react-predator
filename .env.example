# ──────────────────────────────────────────────
# Modu Frontend — Variables de Entorno
# ──────────────────────────────────────────────

VITE_API_URL=http://localhost:3000/api/v1
# VITE_APP_NAME=Modu
VITE_TOKEN_EXPIRY_MINUTES=60
VITE_MOCK_ENABLED=true
VITE_MOCK_SECRET=modu-dev-secret-2025
VITE_APP_NAMESPACE=UapaVerse
# ─── Método de autenticación ─────────────────
# db   → base de datos (endpoint /auth/login)
# ldap → LDAP/AD (endpoint /auth/ldap/login)
VITE_AUTH_METHOD=ldap

# ─── Configuración LDAP ──────────────────────
VITE_LDAP_HOST=ldap.example.com
VITE_LDAP_PORT=389
VITE_LDAP_BASE_DN=dc=modu,dc=edu
VITE_LDAP_DOMAIN=modu.edu
VITE_LDAP_BIND_DN=cn=admin,dc=modu,dc=edu
VITE_LDAP_BIND_PASSWORD=admin-ldap-secret

# ─── Credenciales de prueba (mock LDAP) ──────
VITE_LDAP_MOCK_USER1=admin@modu.edu
VITE_LDAP_MOCK_PASS1=Admin123!
VITE_LDAP_MOCK_USER2=maria.garcia@modu.edu
VITE_LDAP_MOCK_PASS2=Maria2025!
VITE_LDAP_MOCK_USER3=carlos.lopez@modu.edu
VITE_LDAP_MOCK_PASS3=Carlos2025!