{
  "version": "1.0",
  "description": "Schema de validación para el wizard de creación de módulos",
  "module": {
    "label": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9 \\s\\-']+$",
      "message": "El nombre del módulo es obligatorio y debe contener solo caracteres válidos"
    },
    "slug": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[a-z0-9\\-]+$",
      "message": "El slug debe contener solo letras minúsculas, números y guiones"
    },
    "color": {
      "type": "string",
      "required": true,
      "allowedValues": ["blue", "purple", "green", "amber", "pink", "orange", "cyan", "indigo"],
      "defaultValue": "blue",
      "message": "Color no válido"
    },
    "icon": {
      "type": "string",
      "required": false,
      "defaultValue": "LayoutGrid",
      "message": "Ícono no válido"
    },
    "viewOptions": {
      "type": "array",
      "required": true,
      "minItems": 1,
      "maxItems": 10,
      "itemSchema": {
        "label": { "type": "string", "required": true, "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "required": true, "minLength": 1, "maxLength": 50, "pattern": "^[a-z0-9\\-]+$" },
        "description": { "type": "string", "required": false, "maxLength": 200 },
        "kind": { "type": "string", "required": true, "allowedValues": ["summary", "table", "archived", "upload"] }
      }
    },
    "columns": {
      "type": "array",
      "required": false,
      "itemSchema": {
        "key": { "type": "string", "required": true, "minLength": 1, "maxLength": 100, "pattern": "^[a-zA-Z0-9_]+$" },
        "header": { "type": "string", "required": true, "minLength": 1, "maxLength": 200 },
        "type": { "type": "string", "required": true, "allowedValues": ["text", "number", "date", "select", "list"] },
        "options": { "type": "array", "required": false, "itemType": "string" },
        "chartGroup": { "type": "boolean", "required": false, "defaultValue": false }
      }
    }
  }
}
